# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# --------------------------------------------------
# Required
# --------------------------------------------------

# YouTube Data API v3 key from console.cloud.google.com > APIs & Services > Credentials.
# Restrict this key to the YouTube Data API v3 only.
YOUTUBE_API_KEY=your-key-here


# --------------------------------------------------
# Optional overrides (defaults live in src/trend_intel/config.py)
# --------------------------------------------------

# Comma-separated topic basket. Changing this changes what the whole pipeline tracks.
# TREND_INTEL_TOPICS=AI agents,Agentic AI,Vibe coding,Model Context Protocol,Multimodal AI

# Two-letter region code used for both Google Trends geo and YouTube regionCode.
# TREND_INTEL_REGION=CA

# Google Trends lookback window. See pytrends docs for accepted values.
# TREND_INTEL_TIMEFRAME=today 3-m

# How many complete days of YouTube uploads to search.
# TREND_INTEL_YOUTUBE_WINDOW_DAYS=7

# Where outputs are written. Set to a /tmp path inside Cloud Functions.
# TREND_INTEL_DATA_DIR=data

# Set to 1 to emit structured JSON logs (done automatically in Cloud Functions).
# TREND_INTEL_JSON_LOGS=0
